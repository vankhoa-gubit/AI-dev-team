{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["objective", "tasks", "integration_acceptance_criteria", "integration_checks"],
  "properties": {
    "objective": { "type": "string", "minLength": 1 },
    "tasks": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "objective", "allowed_paths", "acceptance_criteria", "checks", "worker_instructions"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" },
          "objective": { "type": "string", "minLength": 1 },
          "allowed_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["command", "args"],
              "properties": {
                "command": { "type": "string", "minLength": 1 },
                "args": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "worker_instructions": { "type": "string", "minLength": 1 }
        }
      }
    },
    "integration_acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "integration_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "args"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "args": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
