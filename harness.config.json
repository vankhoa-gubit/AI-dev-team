{
  "dataDirectory": ".harness",
  "maxRevisionRounds": 2,
  "requireCleanRepository": true,
  "antigravity": {
    "command": "agy",
    "effort": "high",
    "timeoutMs": 1200000
  },
  "validation": {
    "timeoutMs": 600000,
    "allowedExecutables": [
      "node",
      "npm",
      "npm.cmd",
      "npx",
      "npx.cmd",
      "pnpm",
      "pnpm.cmd",
      "yarn",
      "yarn.cmd",
      "python",
      "python.exe",
      "pytest",
      "pytest.exe",
      "dotnet",
      "go",
      "cargo"
    ]
  },
  "delegation": {
    "maxConcurrentWorkers": 3,
    "maxDiffBytes": 262144,
    "maxDiffLines": 2000
  }
}
