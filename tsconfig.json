{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/adapters/antigravity.ts",
    "src/cli.ts",
    "src/config.ts",
    "src/git.ts",
    "src/interactive-delegation.ts",
    "src/mcp-server.ts",
    "src/output.ts",
    "src/process.ts",
    "src/scope.ts",
    "src/types.ts",
    "src/validation.ts",
    "tests/mcp.test.ts"
  ]
}
